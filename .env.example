# =============================================================================
# $ONBOARDING — environment variables
# Copy this file to `.env` (in the repo ROOT) and fill in the REPLACE_ values.
# The app runs in DEMO MODE until Supabase + Solana values are set.
# Only VITE_* vars reach the browser — never put secret/service keys here.
# =============================================================================

# ---- Supabase (auth + Postgres + storage) ----------------------------------
# Project Settings -> API in your Supabase dashboard.
VITE_SUPABASE_URL=REPLACE_WITH_SUPABASE_PROJECT_URL          # e.g. https://abcd1234.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_PUBLIC_KEY # the ANON public key ONLY (never service_role)

# ---- Solana network / RPC --------------------------------------------------
VITE_SOLANA_NETWORK=devnet                                   # mainnet-beta | devnet | testnet | localnet
# Public devnet RPC is fine for testing. For production use a paid RPC
# (Helius / Triton / QuickNode) — public endpoints are rate-limited.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# ---- $ONBOARDING token -----------------------------------------------------
VITE_ONBOARDING_MINT=REPLACE_WITH_ONBOARDING_SPL_MINT        # SPL mint address of $ONBOARDING

# ---- Platform fee / buyback-and-burn program -------------------------------
VITE_PLATFORM_FEE_BPS=200                                    # 200 = 2% (keep in sync with the Anchor program)
# Deployed Anchor program id (from `anchor keys list` after build). Required
# only for the on-chain program-routed tip path.
VITE_FEE_PROGRAM_ID=REPLACE_WITH_DEPLOYED_FEE_PROGRAM_ID
# Where the 2% SOL fee is sent on the FRONT-END (demo) path. Use a wallet you
# control, or the program's fee-vault PDA once deployed.
VITE_FEE_WALLET=REPLACE_WITH_FEE_VAULT_OR_WALLET_ADDRESS
# Jupiter quote/swap API (used by the off-chain buyback crank).
VITE_JUPITER_API=https://quote-api.jup.ag/v6
